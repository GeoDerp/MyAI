# Research Agent Configuration
# Copy this to .env and fill in your values

# === OpenAI Configuration ===
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-key-here

# === Anthropic Configuration (optional) ===
# Get your API key from: https://console.anthropic.com/
# ANTHROPIC_API_KEY=sk-ant-your-key-here

# === Google Configuration (optional) ===
# Get your API key from: https://makersuite.google.com/app/apikey
# GOOGLE_API_KEY=your-key-here

# === RamaLama Configuration (for local models) ===
# Default model to use with RamaLama
RAMALAMA_MODEL=granite

# Port for RamaLama service
RAMALAMA_PORT=8080

# === Agent Configuration ===
# Default model to use (can be overridden in code)
# Options: openai:gpt-4o, openai:gpt-4o-mini, anthropic:claude-sonnet-4-0, etc.
DEFAULT_MODEL=openai:gpt-4o

# Maximum research iterations
MAX_ITERATIONS=10

# Minimum confidence level (0-10) to stop researching
MIN_CONFIDENCE=8

# === Logfire Configuration (optional, for observability) ===
# Sign up at: https://logfire.pydantic.dev/
# LOGFIRE_TOKEN=your-token-here

# === Search Configuration ===
# Number of search results to fetch per query
SEARCH_RESULTS_LIMIT=10

# Timeout for search operations (seconds)
SEARCH_TIMEOUT=30
